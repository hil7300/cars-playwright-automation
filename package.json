{
    "name": "cars_playwright_automation",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "create-allure-report": "npx allure generate allure-results --single-file --clean -o playwright-report/allure-report && ts-node rename-report.ts",
        "test": "npx playwright test",
        "stg:test": "cross-env ENV=stg npx playwright test --workers=3",
        "dev:test": "cross-env ENV=dev npx playwright test --workers=3",
        "local:test": "cross-env ENV=local npx playwright test --workers=2 --grep-invert @requires-triggers",
        "local:smoke": "cross-env ENV=local npx playwright test  --workers=2 --grep @smoke --grep-invert @requires-triggers",
        "prod:test": "cross-env ENV=prod npx playwright test",
        "smoke:test": "npx playwright test --grep '@smoke'",
        "dev:smoke": "cross-env ENV=dev npx playwright test --grep '@smoke'",
        "stg:smoke": "cross-env ENV=stg npx playwright test --grep '@smoke'",
        "prod:smoke": "cross-env ENV=prod npx playwright test --grep '@smoke' --workers=1",
        "parse:summary": "ts-node parse-summary.ts",
        "dev:regression-report": "cross-env ENV=dev ts-node generate-regression-report.ts",
        "stg:regression-report": "cross-env ENV=stg ts-node generate-regression-report.ts",
        "dev:notify-teams": "cross-env ENV=dev ts-node notify-teams.ts",
        "stg:notify-teams": "cross-env ENV=stg ts-node notify-teams.ts",
        "prod:notify-teams": "cross-env ENV=prod ts-node notify-teams.ts",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix",
        "format": "prettier --write \"**/*.{ts,json,md}\"",
        "format:check": "prettier --check \"**/*.{ts,json,md}\"",
        "typecheck": "tsc --noEmit",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hil7300/cars_playwright_automation.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/hil7300/cars_playwright_automation/issues"
    },
    "homepage": "https://github.com/hil7300/cars_playwright_automation#readme",
    "description": "",
    "devDependencies": {
        "@playwright/test": "^1.52.0",
        "@types/mailparser": "^3.4.6",
        "@types/node": "^22.15.3",
        "@typescript-eslint/eslint-plugin": "^8.15.0",
        "@typescript-eslint/parser": "^8.15.0",
        "allure-commandline": "^2.30.0",
        "allure-js-commons": "^3.0.0-beta.12",
        "allure-playwright": "^3.0.0-beta.12",
        "cross-env": "^7.0.3",
        "eslint": "^9.15.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-playwright": "^2.1.0",
        "exceljs": "^4.4.0",
        "husky": "^9.1.7",
        "lint-staged": "^15.2.10",
        "prettier": "^3.4.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "@axe-core/playwright": "^4.11.1",
        "@octokit/rest": "^20.0.0",
        "imapflow": "^1.3.2",
        "mailparser": "^3.9.8",
        "openai": "^4.20.0",
        "pdf-parse": "^2.4.5",
        "pixelmatch": "^5.3.0",
        "pngjs": "^7.0.0",
        "xlsx": "^0.18.5"
    },
    "lint-staged": {
        "*.ts": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md}": [
            "prettier --write"
        ]
    }
}
